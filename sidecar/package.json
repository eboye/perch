{
  "name": "perch-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "JSON-RPC (stdio) bridge between the Perch GTK UI and rettiwt-api",
  "main": "src/main.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/sidecar.cjs --external:@xdevplatform/chat-xdk --log-level=warning"
